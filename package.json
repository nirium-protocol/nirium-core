{
  "name": "nirium-root",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter nirium-web --filter @nirium/agent run dev",
    "build": "pnpm --filter nirium-web --filter @nirium/agent run build",
    "start": "pnpm --filter nirium-web start",
    "start:agent": "pnpm --filter @nirium/agent start",
    "start:web": "pnpm --filter nirium-web start",
    "ship": "vercel --prod",
    "postinstall": "node -e \"try{require('./scripts/postinstall.js')}catch(e){console.log('[postinstall] skipped:',e.message)}\""
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@9.12.2",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "overrides": {
      "handlebars": ">=4.7.10",
      "defu": ">=6.1.5",
      "axios": "^1.20.0",
      "browserslist": "^4.28.7",
      "protobufjs": "^7.6.6",
      "brace-expansion@1": "1.1.21",
      "brace-expansion@2": "2.1.7",
      "fast-uri": "^3.1.8",
      "hono": "^4.12.25",
      "ip-address": "^10.3.1",
      "js-yaml": "^3.15.1",
      "nanoid": "^3.3.18",
      "next": "^15.5.28",
      "postcss": "^8.5.18",
      "sharp": "^0.35.5",
      "@toon-format/toon": ">=2.3.1",
      "toml": ">=5.0.1",
      "smol-toml": ">=1.7.1",
      "undici@6": "6.29.1",
      "undici@8": "8.12.2",
      "ws@7": "7.5.11",
      "ws@8": "8.21.3",
      "source-map-js": ">=1.2.2",
      "proxy-addr": ">=2.0.8",
      "follow-redirects": ">=1.16.1",
      "@modelcontextprotocol/sdk": ">=1.31.0",
      "zod@4": "^4.6.6",
      "body-parser": ">=2.4.0"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-vfj7-8cjw-p6xm",
        "GHSA-mrhx-c7xc-m3w5"
      ]
    }
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "@stellar/mpp": "^0.4.0",
    "@vercel/analytics": "^1.6.1",
    "@x402/core": "^2.9.0",
    "@x402/express": "^2.9.0",
    "@x402/fetch": "^2.9.0",
    "@x402/stellar": "^2.9.0",
    "class-variance-authority": "^0.7.1",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "mppx": "^0.5.5"
  }
}
