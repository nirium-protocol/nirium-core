# Public mirror of the Nirium monorepo. Generic rules only: this file is
# published, so it names no internal file.

# Dependencies
node_modules/
.pnpm-store/

# Build output (root-anchored where a folder name is also a site route)
/dist/
/build/
/out/
apps/web/out/
.next/
.next-internal/
*.tsbuildinfo
next-env.d.ts

# Rust / Soroban
target/
**/test_snapshots/
fuzz/artifacts/
fuzz/corpus/
fuzz/coverage/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Secrets and local configuration: never commit these
.env
.env.*
!.env.example
*.pem
*.key
*secret*.json
*_keys.json
central_issuer.json
.contract-ids.env

# Deployment and tooling state
.vercel/
.turbo/
coverage/

# Logs and OS files
*.log
npm-debug.log*
pnpm-debug.log*
.DS_Store
Thumbs.db

# Editors and local AI tooling
.idea/
.vscode/
.claude/
.agents/
