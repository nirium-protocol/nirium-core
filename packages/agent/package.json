{
    "name": "@nirium/agent",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Nirium Autonomous Agent Backend — Market scanner, AI loop, skill system",
    "main": "dist/src/index.js",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "rm -rf dist && tsc && node scripts/obfuscate.js",
        "start": "node --max-old-space-size=4096 dist/src/index.js",
        "swarm": "tsx scripts/nirium_full_swarm.ts",
        "start:swarm": "tsx scripts/nirium_full_swarm.ts",
        "start:indexer": "tsx scripts/nirium_indexer.ts",
        "start:pool": "tsx scripts/initialize_pool.ts",
        "start:protocol": "tsx scripts/initialize_protocol.ts",
        "generate-swarm": "tsx scripts/generate_swarm.ts",
        "x402:buy": "tsx src/scripts/x402_buyer_agent.ts",
        "mpp:buy": "tsx src/scripts/mpp_buyer_agent.ts",
        "lint": "eslint src/",
        "test": "jest --passWithNoTests"
    },
    "dependencies": {
        "@remix-run/node-fetch-server": "^0.13.0",
        "@stellar/mpp": "^0.7.1",
        "@stellar/stellar-sdk": "^14.0.0",
        "@supabase/supabase-js": "^2.97.0",
        "@x402/core": "^2.28.0",
        "@x402/express": "^2.17.0",
        "@x402/fetch": "^2.17.0",
        "@x402/stellar": "^2.17.0",
        "axios": "^1.13.6",
        "chalk": "5.3.0",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^5.1.0",
        "jsonwebtoken": "^9.0.2",
        "mppx": "^0.6.31",
        "node-cron": "^3.0.3",
        "undici": "^8.12.2",
        "uuid": "^11.1.0",
        "ws": "^8.18.0"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.0",
        "@types/jest": "^30.0.0",
        "@types/jsonwebtoken": "^9.0.7",
        "@types/node": "^22.0.0",
        "@types/node-cron": "^3.0.11",
        "@types/uuid": "^10.0.0",
        "@types/ws": "^8.5.13",
        "javascript-obfuscator": "^5.4.1",
        "jest": "^30.0.0",
        "ts-jest": "^29.4.6",
        "tsx": "^4.19.0",
        "typescript": "^5.7.0"
    }
}